{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AccuracyControl": {
      "description": "Local integration or bounded sampled-trajectory convergence checking.",
      "enum": [
        "local",
        "sampled"
      ],
      "type": "string"
    },
    "ActiveInputs": {
      "enum": [
        "continue",
        "stop_target"
      ],
      "type": "string"
    },
    "Administration": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/definitions/Quantity"
        },
        "bioavailability": {
          "format": "double",
          "type": "number"
        },
        "delivery": {
          "$ref": "#/definitions/Delivery"
        },
        "lag": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat": {
          "anyOf": [
            {
              "$ref": "#/definitions/Repeat"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "amount",
        "bioavailability",
        "delivery",
        "target",
        "time"
      ],
      "type": "object"
    },
    "BindingKind": {
      "enum": [
        "parameter",
        "covariate",
        "individual_parameter",
        "derived_covariate"
      ],
      "type": "string"
    },
    "BoundInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/BindingKind"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/definitions/ExactUnit"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "name",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "description": "Work counts RHS and Jacobian calls, including solver setup, or bounded analytic interval propagations when an analytic model opts into that path.",
      "properties": {
        "events": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "output_values": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "solver_callbacks": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "events",
        "output_values",
        "solver_callbacks"
      ],
      "type": "object"
    },
    "CovariateChange": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        },
        "value": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "name",
        "time",
        "value"
      ],
      "type": "object"
    },
    "CycleIterationRequest": {
      "additionalProperties": false,
      "description": "Bounded nonlinear iteration; run.initial_states supplies the starting guess.",
      "properties": {
        "absolute_tolerances": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "type": "object"
        },
        "maximum_cycles": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "relative_tolerance": {
          "format": "double",
          "type": "number"
        },
        "run": {
          "$ref": "#/definitions/RunRequest"
        },
        "time_basis": {
          "$ref": "#/definitions/PeriodicTimeBasis"
        }
      },
      "required": [
        "absolute_tolerances",
        "maximum_cycles",
        "relative_tolerance",
        "run",
        "time_basis"
      ],
      "type": "object"
    },
    "DeferredCheck": {
      "enum": [
        "trajectory_domain",
        "readout_domain",
        "numerical_convergence",
        "independent_scientific_qualification",
        "optimization",
        "identifiability",
        "observed_covariance",
        "elementary_effect_overflow"
      ],
      "type": "string"
    },
    "Delivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "bolus"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "infusion"
              ],
              "type": "string"
            },
            "span": {
              "$ref": "#/definitions/InfusionSpan"
            }
          },
          "required": [
            "kind",
            "span"
          ],
          "type": "object"
        }
      ]
    },
    "Event": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "active_inputs": {
              "$ref": "#/definitions/ActiveInputs"
            },
            "kind": {
              "enum": [
                "reset"
              ],
              "type": "string"
            },
            "order": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "active_inputs",
            "kind",
            "order",
            "target",
            "time",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "bolus"
              ],
              "type": "string"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "amount",
            "kind",
            "target",
            "time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "format": "double",
              "type": "number"
            },
            "duration": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "infusion"
              ],
              "type": "string"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "amount",
            "duration",
            "kind",
            "target",
            "time"
          ],
          "type": "object"
        }
      ]
    },
    "ExactUnit": {
      "additionalProperties": false,
      "properties": {
        "declared": {
          "description": "Original declared spelling, when the unit was not inferred.",
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "description": "SI kg, m, s, mol, K, A, cd exponents, followed by opaque activity.",
          "items": {
            "format": "int16",
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "entities": {
          "additionalProperties": false,
          "description": "Nonzero opaque entity exponents, keyed by cell or genome. Empty for legacy units.",
          "properties": {
            "cell": {
              "format": "int16",
              "type": "integer"
            },
            "genome": {
              "format": "int16",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "scale_denominator": {
          "type": "string"
        },
        "scale_numerator": {
          "description": "Positive exact rational scale to the dimension's base coordinates. Decimal strings preserve integers beyond JSON's exact numeric range.",
          "type": "string"
        }
      },
      "required": [
        "dimensions",
        "scale_denominator",
        "scale_numerator"
      ],
      "type": "object"
    },
    "ExecutionIdentity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        },
        "bound_value_hash": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        },
        "compiler_source_sha256": {
          "type": "string"
        },
        "compiler_version": {
          "type": "string"
        },
        "model_content_hash": {
          "type": "string"
        },
        "run_request_hash": {
          "type": "string"
        },
        "rustc_version": {
          "type": "string"
        },
        "rustflags_sha256": {
          "type": "string"
        },
        "spec_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "backend",
        "backend_version",
        "bound_value_hash",
        "build_profile",
        "compiler_source_sha256",
        "compiler_version",
        "model_content_hash",
        "run_request_hash",
        "rustc_version",
        "rustflags_sha256",
        "spec_version",
        "target"
      ],
      "type": "object"
    },
    "InfusionSpan": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "duration": {
              "$ref": "#/definitions/Quantity"
            },
            "kind": {
              "enum": [
                "duration"
              ],
              "type": "string"
            }
          },
          "required": [
            "duration",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "rate"
              ],
              "type": "string"
            },
            "rate": {
              "$ref": "#/definitions/Quantity"
            }
          },
          "required": [
            "kind",
            "rate"
          ],
          "type": "object"
        }
      ]
    },
    "ObservationPoint": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "$ref": "#/definitions/ObservationSide"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "side",
        "time"
      ],
      "type": "object"
    },
    "ObservationSide": {
      "enum": [
        "pre",
        "post"
      ],
      "type": "string"
    },
    "PeriodicPlanRequest": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "steady_state"
              ],
              "type": "string"
            },
            "request": {
              "$ref": "#/definitions/SteadyStateRequest"
            }
          },
          "required": [
            "operation",
            "request"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "iterate_periodic"
              ],
              "type": "string"
            },
            "request": {
              "$ref": "#/definitions/CycleIterationRequest"
            }
          },
          "required": [
            "operation",
            "request"
          ],
          "type": "object"
        }
      ]
    },
    "PeriodicPlanSchema": {
      "enum": [
        "qspquest.periodic-plan/v0.1"
      ],
      "type": "string"
    },
    "PeriodicStatePlan": {
      "additionalProperties": false,
      "properties": {
        "convergence_absolute_tolerance": {
          "format": "double",
          "type": "number"
        },
        "integration_absolute_tolerance": {
          "description": "None for the analytic propagator; its numerical method does not use a local solver tolerance.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "seed": {
          "description": "None for the affine fixed-point solve; iteration retains the supplied seed.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "convergence_absolute_tolerance",
        "name",
        "unit"
      ],
      "type": "object"
    },
    "PeriodicTimeBasis": {
      "enum": [
        "cycle_phase"
      ],
      "type": "string"
    },
    "Protocol": {
      "additionalProperties": false,
      "properties": {
        "atol": {
          "format": "double",
          "type": "number"
        },
        "end": {
          "format": "double",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/definitions/Event"
          },
          "type": "array"
        },
        "rtol": {
          "format": "double",
          "type": "number"
        },
        "samples": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "start": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "atol",
        "end",
        "events",
        "rtol",
        "samples"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "type": "object"
    },
    "Repeat": {
      "additionalProperties": false,
      "properties": {
        "additional": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "interval": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "additional",
        "interval"
      ],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "Unit-bearing times and administrations with the existing scalar tolerance contract.",
      "properties": {
        "absolute_tolerances": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "description": "Exactly one positive quantity for each state, identified by name.",
          "type": [
            "object",
            "null"
          ]
        },
        "administrations": {
          "items": {
            "$ref": "#/definitions/Administration"
          },
          "type": "array"
        },
        "atol": {
          "description": "Legacy scalar in each state's numeric unit; exclusive with absolute_tolerances.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "checkpoints": {
          "default": [],
          "description": "Fixed solver restart times; these do not change state or parameters.",
          "items": {
            "$ref": "#/definitions/Quantity"
          },
          "type": "array"
        },
        "covariate_changes": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CovariateChange"
          },
          "type": "array"
        },
        "covariates": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "end": {
          "$ref": "#/definitions/Quantity"
        },
        "observations": {
          "items": {
            "$ref": "#/definitions/ObservationPoint"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "resets": {
          "default": [],
          "items": {
            "$ref": "#/definitions/StateReset"
          },
          "type": "array"
        },
        "rtol": {
          "format": "double",
          "type": "number"
        },
        "samples": {
          "items": {
            "$ref": "#/definitions/Quantity"
          },
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "administrations",
        "end",
        "rtol",
        "samples"
      ],
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "properties": {
        "accuracy_control": {
          "$ref": "#/definitions/AccuracyControl"
        },
        "budgets": {
          "$ref": "#/definitions/Budgets"
        },
        "initial_states": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "regimen": {
          "$ref": "#/definitions/Request"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "$ref": "#/definitions/RunSchema"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "solver": {
          "$ref": "#/definitions/Solver"
        }
      },
      "required": [
        "budgets",
        "regimen",
        "schema",
        "solver"
      ],
      "type": "object"
    },
    "RunSchema": {
      "enum": [
        "qspquest.run/v0.1"
      ],
      "type": "string"
    },
    "Solver": {
      "enum": [
        "diffsol_bdf",
        "diffsol_tsit45",
        "diffsol_esdirk34",
        "diffsol_tr_bdf2",
        "diffsol_rosenbrock23",
        "diffsol_rodas5p",
        "analytic_linear_pk"
      ],
      "type": "string"
    },
    "StateReset": {
      "additionalProperties": false,
      "properties": {
        "active_inputs": {
          "$ref": "#/definitions/ActiveInputs"
        },
        "order": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "target": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        },
        "value": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "active_inputs",
        "order",
        "target",
        "time",
        "value"
      ],
      "type": "object"
    },
    "SteadyStateRequest": {
      "additionalProperties": false,
      "description": "A single periodic cycle. The nested run supplies parameters, regimen and budgets. Initial overrides are prohibited: this operation solves for the initial state.",
      "properties": {
        "absolute_tolerance": {
          "$ref": "#/definitions/Quantity"
        },
        "relative_tolerance": {
          "format": "double",
          "type": "number"
        },
        "run": {
          "$ref": "#/definitions/RunRequest"
        }
      },
      "required": [
        "absolute_tolerance",
        "relative_tolerance",
        "run"
      ],
      "type": "object"
    }
  },
  "properties": {
    "convergence_relative_tolerance": {
      "format": "double",
      "type": "number"
    },
    "cycle": {
      "allOf": [
        {
          "$ref": "#/definitions/Protocol"
        }
      ],
      "description": "Exact normalized phase cycle, including folded infusion carryover."
    },
    "deferred_checks": {
      "items": {
        "$ref": "#/definitions/DeferredCheck"
      },
      "type": "array"
    },
    "event_quantity_units": {
      "description": "In cycle.events order. Affine solver doses have already been scaled into state amounts.",
      "items": {
        "$ref": "#/definitions/ExactUnit"
      },
      "type": "array"
    },
    "fixed_point_uniqueness_and_stability_certified": {
      "description": "Neither admission nor convergence from a seed establishes uniqueness or stability.",
      "type": "boolean"
    },
    "inputs": {
      "items": {
        "$ref": "#/definitions/BoundInput"
      },
      "type": "array"
    },
    "maximum_cycle_executions": {
      "description": "n+2 for the affine solve; maximum_cycles for BDF iteration.",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "per_cycle_budgets": {
      "$ref": "#/definitions/Budgets"
    },
    "prospective_identity": {
      "$ref": "#/definitions/ExecutionIdentity"
    },
    "request": {
      "$ref": "#/definitions/PeriodicPlanRequest"
    },
    "schema": {
      "$ref": "#/definitions/PeriodicPlanSchema"
    },
    "states": {
      "items": {
        "$ref": "#/definitions/PeriodicStatePlan"
      },
      "type": "array"
    },
    "time_unit": {
      "type": "string"
    },
    "total_budgets": {
      "$ref": "#/definitions/Budgets"
    }
  },
  "required": [
    "convergence_relative_tolerance",
    "cycle",
    "deferred_checks",
    "event_quantity_units",
    "fixed_point_uniqueness_and_stability_certified",
    "inputs",
    "maximum_cycle_executions",
    "per_cycle_budgets",
    "prospective_identity",
    "request",
    "schema",
    "states",
    "time_unit",
    "total_budgets"
  ],
  "title": "PeriodicPlan",
  "type": "object",
  "x-qspquest-spec-version": "qspquest.spec/0.1",
  "x-qspquest-validation": "Structural schema only; compile, bind and validate execution capabilities before running."
}
