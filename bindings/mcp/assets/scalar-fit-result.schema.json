    "FitStatus": {
      "enum": [
        "converged",
        "evaluation_limit",
        "iteration_limit",
        "line_search_failed"
      ],
      "type": "string"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "type": "object"
    },
    "ScalarFitResultSchema": {
      "enum": [
        "qspquest.scalar-fit-result/v0.1"
      ],
      "type": "string"
    },
    "ScalarGaussianObjectiveResult": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/ExecutionIdentity"
        },
        "negative_log_likelihood": {
          "format": "double",
          "type": "number"
        },
        "objective": {
          "format": "double",
          "type": "number"
        },
        "observations": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "identity",
        "negative_log_likelihood",
        "objective",
        "observations"
      ],
      "type": "object"
    }
  },
  "properties": {
    "evaluations": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "fit_request_hash": {
      "type": "string"
    },
    "iterations": {
      "format": "uint",
      "minimum": 0.0,
