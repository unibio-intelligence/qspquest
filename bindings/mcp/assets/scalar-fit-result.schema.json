      "type": "object"
    },
    "schema": {
      "$ref": "#/definitions/ScalarFitResultSchema"
    },
    "status": {
      "$ref": "#/definitions/FitStatus"
    }
  },
  "required": [
    "evaluations",
    "fit_request_hash",
    "iterations",
    "objective",
    "parameters",
    "schema",
    "status"
  ],
  "title": "ScalarGaussianFitResult",
  "type": "object",
  "x-qspquest-spec-version": "qspquest.spec/0.1",
