          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        },
        "bound_value_hash": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        },
        "compiler_source_sha256": {
          "type": "string"
        },
        "compiler_version": {
          "type": "string"
        },
        "model_content_hash": {
          "type": "string"
        },
        "run_request_hash": {
          "type": "string"
        },
        "rustc_version": {
          "type": "string"
        },
        "rustflags_sha256": {
          "type": "string"
        },
        "spec_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "backend",
        "backend_version",
        "bound_value_hash",
        "build_profile",
        "compiler_source_sha256",
        "compiler_version",
        "model_content_hash",
        "run_request_hash",
        "rustc_version",
        "rustflags_sha256",
        "spec_version",
        "target"
      ],
      "type": "object"
