{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AccuracyControl": {
      "description": "Local integration or bounded sampled-trajectory convergence checking.",
      "enum": [
        "local",
        "sampled"
      ],
      "type": "string"
    },
    "ActiveInputs": {
      "enum": [
        "continue",
        "stop_target"
      ],
      "type": "string"
    },
    "Administration": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/definitions/Quantity"
        },
        "bioavailability": {
          "format": "double",
          "type": "number"
        },
        "delivery": {
          "$ref": "#/definitions/Delivery"
        },
        "lag": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat": {
          "anyOf": [
            {
              "$ref": "#/definitions/Repeat"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "amount",
        "bioavailability",
        "delivery",
        "target",
        "time"
      ],
      "type": "object"
    },
    "AugmentedStatePlan": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "format": "double",
          "type": "number"
        },
        "initial": {
          "format": "double",
          "type": "number"
        },
        "parameter": {
          "description": "None is the primal state; derivatives follow selected parameter-major order.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/definitions/ExactUnit"
        }
      },
      "required": [
        "absolute_tolerance",
        "initial",
        "state",
        "unit"
      ],
      "type": "object"
    },
    "BindingActivation": {
      "enum": [
        "initial",
        "post_boundary"
      ],
      "type": "string"
    },
    "BindingKind": {
      "enum": [
        "parameter",
        "covariate",
        "individual_parameter",
        "derived_covariate"
      ],
      "type": "string"
    },
    "BindingPhase": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "$ref": "#/definitions/BindingActivation"
        },
        "inputs": {
          "items": {
            "$ref": "#/definitions/BoundInput"
          },
          "type": "array"
        },
        "time": {
          "description": "Uses RunPlan.time_unit. Initial and post-boundary phases can share a time.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "activation",
        "inputs",
        "time"
      ],
      "type": "object"
    },
    "BoundInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/BindingKind"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/definitions/ExactUnit"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "name",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "description": "Work counts RHS and Jacobian calls, including solver setup, or bounded analytic interval propagations when an analytic model opts into that path.",
      "properties": {
        "events": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "output_values": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "solver_callbacks": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "events",
        "output_values",
        "solver_callbacks"
      ],
      "type": "object"
    },
    "CovariateChange": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        },
        "value": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "name",
        "time",
        "value"
      ],
      "type": "object"
    },
    "DeferredCheck": {
      "enum": [
        "trajectory_domain",
        "readout_domain",
        "numerical_convergence",
        "independent_scientific_qualification",
        "optimization",
        "identifiability",
        "observed_covariance",
        "elementary_effect_overflow"
      ],
      "type": "string"
    },
    "Delivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "bolus"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "infusion"
              ],
              "type": "string"
            },
            "span": {
              "$ref": "#/definitions/InfusionSpan"
            }
          },
          "required": [
            "kind",
            "span"
          ],
          "type": "object"
        }
      ]
    },
    "DerivativeOutputPlan": {
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/definitions/ExactUnit"
        }
      },
      "required": [
        "output",
        "parameter",
        "unit"
      ],
      "type": "object"
    },
    "Event": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "active_inputs": {
              "$ref": "#/definitions/ActiveInputs"
            },
            "kind": {
              "enum": [
                "reset"
              ],
              "type": "string"
            },
            "order": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "active_inputs",
            "kind",
            "order",
            "target",
            "time",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "bolus"
              ],
              "type": "string"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "amount",
            "kind",
            "target",
            "time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "format": "double",
              "type": "number"
            },
            "duration": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "infusion"
              ],
              "type": "string"
            },
            "target": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "amount",
            "duration",
            "kind",
            "target",
            "time"
          ],
          "type": "object"
        }
      ]
    },
    "ExactUnit": {
      "additionalProperties": false,
      "properties": {
        "declared": {
          "description": "Original declared spelling, when the unit was not inferred.",
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "description": "SI kg, m, s, mol, K, A, cd exponents, followed by opaque activity.",
          "items": {
            "format": "int16",
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "entities": {
          "additionalProperties": false,
          "description": "Nonzero opaque entity exponents, keyed by cell or genome. Empty for legacy units.",
          "properties": {
            "cell": {
              "format": "int16",
              "type": "integer"
            },
            "genome": {
              "format": "int16",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "scale_denominator": {
          "type": "string"
        },
        "scale_numerator": {
          "description": "Positive exact rational scale to the dimension's base coordinates. Decimal strings preserve integers beyond JSON's exact numeric range.",
          "type": "string"
        }
      },
      "required": [
        "dimensions",
        "scale_denominator",
        "scale_numerator"
      ],
      "type": "object"
    },
    "ExecutionIdentity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        },
        "bound_value_hash": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        },
        "compiler_source_sha256": {
          "type": "string"
        },
        "compiler_version": {
          "type": "string"
        },
        "model_content_hash": {
          "type": "string"
        },
        "run_request_hash": {
          "type": "string"
        },
        "rustc_version": {
          "type": "string"
        },
        "rustflags_sha256": {
          "type": "string"
        },
        "spec_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "backend",
        "backend_version",
        "bound_value_hash",
        "build_profile",
        "compiler_source_sha256",
        "compiler_version",
        "model_content_hash",
        "run_request_hash",
        "rustc_version",
        "rustflags_sha256",
        "spec_version",
        "target"
      ],
      "type": "object"
    },
    "GaussianCensoring": {
      "enum": [
        "left"
      ],
      "type": "string"
    },
    "GaussianError": {
      "additionalProperties": false,
      "properties": {
        "additive_sd": {
          "allOf": [
            {
              "$ref": "#/definitions/Quantity"
            }
          ],
          "description": "Independent additive standard deviation in the observable's units."
        },
        "model": {
          "allOf": [
            {
              "$ref": "#/definitions/GaussianErrorModel"
            }
          ],
          "description": "Normal errors act on the observable; lognormal errors act on its log."
        },
        "proportional_sd": {
          "description": "Independent proportional standard deviation, dimensionless.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "additive_sd",
        "proportional_sd"
      ],
      "type": "object"
    },
    "GaussianErrorModel": {
      "enum": [
        "normal",
        "lognormal"
      ],
      "type": "string"
    },
    "GaussianObjectivePlanSchema": {
      "enum": [
        "qspquest.gaussian-objective-plan/v0.1"
      ],
      "type": "string"
    },
    "GaussianObjectiveRequest": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/definitions/GaussianObservation"
          },
          "type": "array"
        },
        "priors": {
          "description": "Independent normal priors on natural parameter values; empty for MLE.",
          "items": {
            "$ref": "#/definitions/GaussianPrior"
          },
          "type": "array"
        },
        "simulation": {
          "$ref": "#/definitions/SensitivityRequest"
        }
      },
      "required": [
        "observations",
        "priors",
        "simulation"
      ],
      "type": "object"
    },
    "GaussianObservation": {
      "additionalProperties": false,
      "properties": {
        "censoring": {
          "anyOf": [
            {
              "$ref": "#/definitions/GaussianCensoring"
            },
            {
              "type": "null"
            }
          ],
          "description": "M3-style observation that is known to be below its declared value."
        },
        "error": {
          "$ref": "#/definitions/GaussianError"
        },
        "output": {
          "type": "string"
        },
        "row": {
          "description": "Row in the simulation's ordered observation/result grid.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "value": {
          "allOf": [
            {
              "$ref": "#/definitions/Quantity"
            }
          ],
          "description": "Measured value, or the quantification limit for a censored row."
        }
      },
      "required": [
        "error",
        "output",
        "row",
        "value"
      ],
      "type": "object"
    },
    "GaussianObservationPlan": {
      "additionalProperties": false,
      "properties": {
        "additive_sd": {
          "format": "double",
          "type": "number"
        },
        "censoring": {
          "anyOf": [
            {
              "$ref": "#/definitions/GaussianCensoring"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "$ref": "#/definitions/GaussianErrorModel"
        },
        "output": {
          "type": "string"
        },
        "proportional_sd": {
          "description": "Dimensionless relative SD for normal errors; log SD for lognormal errors.",
          "format": "double",
          "type": "number"
        },
        "row": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "additive_sd",
        "model",
        "output",
        "proportional_sd",
        "row",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "GaussianPrior": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "$ref": "#/definitions/Quantity"
        },
        "parameter": {
          "type": "string"
        },
        "sd": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "mean",
        "parameter",
        "sd"
      ],
      "type": "object"
    },
    "GaussianPriorPlan": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "format": "double",
          "type": "number"
        },
        "parameter": {
          "type": "string"
        },
        "sd": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "mean",
        "parameter",
        "sd",
        "unit"
      ],
      "type": "object"
    },
    "InfusionSpan": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "duration": {
              "$ref": "#/definitions/Quantity"
            },
            "kind": {
              "enum": [
                "duration"
              ],
              "type": "string"
            }
          },
          "required": [
            "duration",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "rate"
              ],
              "type": "string"
            },
            "rate": {
              "$ref": "#/definitions/Quantity"
            }
          },
          "required": [
            "kind",
            "rate"
          ],
          "type": "object"
        }
      ]
    },
    "ObservationPoint": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "$ref": "#/definitions/ObservationSide"
        },
        "time": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "side",
        "time"
      ],
      "type": "object"
    },
    "ObservationSide": {
      "enum": [
        "pre",
        "post"
      ],
      "type": "string"
    },
    "PlannedEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "allOf": [
            {
              "$ref": "#/definitions/Event"
            }
          ],
          "description": "Driver storage order is preserved. Reset.order remains the reset ordering key. All event times and infusion durations use RunPlan.time_unit."
        },
        "quantity_unit": {
          "allOf": [
            {
              "$ref": "#/definitions/ExactUnit"
            }
          ],
          "description": "Reset value uses state units; delivered dose amount uses input units before model scaling."
        },
        "target_name": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "quantity_unit",
        "target_name"
      ],
      "type": "object"
    },
    "PlannedObservation": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "$ref": "#/definitions/ObservationSide"
        },
        "time": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "side",
        "time"
      ],
      "type": "object"
    },
    "PlannedOutput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "type": "object"
    },
    "Repeat": {
      "additionalProperties": false,
      "properties": {
        "additional": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "interval": {
          "$ref": "#/definitions/Quantity"
        }
      },
      "required": [
        "additional",
        "interval"
      ],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "Unit-bearing times and administrations with the existing scalar tolerance contract.",
      "properties": {
        "absolute_tolerances": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "description": "Exactly one positive quantity for each state, identified by name.",
          "type": [
            "object",
            "null"
          ]
        },
        "administrations": {
          "items": {
            "$ref": "#/definitions/Administration"
          },
          "type": "array"
        },
        "atol": {
          "description": "Legacy scalar in each state's numeric unit; exclusive with absolute_tolerances.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "checkpoints": {
          "default": [],
          "description": "Fixed solver restart times; these do not change state or parameters.",
          "items": {
            "$ref": "#/definitions/Quantity"
          },
          "type": "array"
        },
        "covariate_changes": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CovariateChange"
          },
          "type": "array"
        },
        "covariates": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "end": {
          "$ref": "#/definitions/Quantity"
        },
        "observations": {
          "items": {
            "$ref": "#/definitions/ObservationPoint"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "resets": {
          "default": [],
          "items": {
            "$ref": "#/definitions/StateReset"
          },
          "type": "array"
        },
        "rtol": {
          "format": "double",
          "type": "number"
        },
        "samples": {
          "items": {
            "$ref": "#/definitions/Quantity"
          },
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "administrations",
        "end",
        "rtol",
        "samples"
      ],
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "properties": {
        "accuracy_control": {
          "$ref": "#/definitions/AccuracyControl"
        },
        "budgets": {
          "$ref": "#/definitions/Budgets"
        },
        "initial_states": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/definitions/Quantity"
          },
          "default": {},
          "type": "object"
        },
        "regimen": {
          "$ref": "#/definitions/Request"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "$ref": "#/definitions/RunSchema"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "solver": {
          "$ref": "#/definitions/Solver"
        }
      },
      "required": [
        "budgets",
        "regimen",
        "schema",
        "solver"
      ],
      "type": "object"
    },
    "RunSchema": {
      "enum": [
        "qspquest.run/v0.1"
      ],
      "type": "string"
    },
    "RunWorkload": {
      "additionalProperties": false,
      "properties": {
        "binding_phases": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "budgets": {
          "allOf": [
            {
              "$ref": "#/definitions/Budgets"
            }
          ],
          "description": "Ceilings, not predicted runtime or callback counts."
        },
        "driver_rows": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "events": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "outputs": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "readout_override_values": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "reserved_binding_values": {
          "description": "Conservative reservation used by admission, including binding storage.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "reserved_events": {
          "description": "Events plus binding/checkpoint discontinuities, as charged by driver admission.",
          "format": "uint",
