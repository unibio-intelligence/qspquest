@dataclass(frozen=True)
class IndividualFitDataset:
    _request_json: str
    _mapping_json: str
    @property
    def request(self) -> dict[str, Any]: ...
    @property
    def mapping(self) -> list[dict[str, Any]]: ...
    def plan(self, source: str | dict[str, Any]) -> dict[str, Any]: ...
    def fit(self, source: str | dict[str, Any]) -> dict[str, Any]: ...

def individual_fit_dataset(data: list[dict[str, Any]], template: dict[str, Any], *, endpoints: dict[str, dict[str, Any]]) -> IndividualFitDataset: ...

@dataclass(frozen=True)
class PopulationFitDataset:
    request: dict[str, Any]
    subject_ids: tuple[str, ...]
    mapping: tuple[dict[str, Any], ...]
    def to_subjects(self, *, covariates: dict[str, dict[str, float | str]] | None = ...) -> list[AnalysisSubject]: ...
    def fit(self, model: CompiledModel, parameters: dict[str, ParameterSpec] | dict[str, Any], omega: Sequence[Sequence[float]], error: ResidualError | FixedResidualError | dict[str, Any], *, covariates_by_subject: dict[str, dict[str, float | str]] | None = ..., covariates: Sequence[CovariateSpec] = ..., covariance: Literal['full', 'diagonal'] = ..., variance_bounds: Sequence[float] | Sequence[Sequence[float]] = ..., seed: int = ..., max_iterations: int = ..., burn_in: int = ..., sweeps: int = ..., tolerance: float = ..., max_simulations: int = ..., control: AnalysisControl | None = ...) -> AnalysisResult: ...

def population_fit_dataset(
    data: Any,
    template: str | dict[str, Any],
    *,
    compartments: dict[Any, str],
    endpoints: dict[Any, dict[str, Any]],
    time_unit: str,
    amount_unit: str,
    rate_unit: str | None = ...,
    observation_side: str = ...,
) -> PopulationFitDataset: ...

class QSPQuestError(ValueError):
    diagnostic: dict[str, Any]
    code: str
    time: float | None
    expression: str | None
    line: int | None
    column: int | None
    def __init__(self, diagnostic: dict[str, Any]) -> None: ...
    def explain(self) -> ScientificStatus: ...

class CompiledModel:
    def __init__(self, source: str | dict[str, Any]) -> None: ...
    @property
    def model_content_hash(self) -> str: ...
    @property
    def output_names(self) -> list[str]: ...
    @property
    def output_units(self) -> list[str]: ...
    def validate_run(self, request: str | dict[str, Any]) -> dict[str, Any]: ...
    def run(self, request: str | RunRequest | dict[str, Any]) -> AnalysisResult: ...
    def morris(self, request: str | MorrisExecutionRequest | dict[str, Any]) -> MorrisExecutionResult: ...
    def morris_json(self, request: str | dict[str, Any]) -> str: ...
    def scan(self, request: str | ScanRequest | dict[str, Any]) -> ScanResult: ...
    def scan_json(self, request: str | dict[str, Any]) -> str: ...
    def periodic_steady_state(self, request: str | SteadyStateRequest | dict[str, Any]) -> SteadyStateResult: ...
    def iterate_periodic_state(self, request: str | CycleIterationRequest | dict[str, Any]) -> CycleIterationResult: ...
    def run_json(self, request: str | RunRequest | dict[str, Any]) -> str: ...
    def fit_scalar(self, request: str | ScalarGaussianFitRequest | dict[str, Any]) -> ScalarGaussianFitResult: ...
    def fit_scalar_json(self, request: str | dict[str, Any]) -> str: ...
    def fit_data(self, run: RunRequest | dict[str, Any], observations: list[AnalysisObservation] | list[dict[str, Any]], parameters: dict[str, ParameterSpec] | dict[str, Any], error: ResidualError | FixedResidualError | dict[str, Any], *, max_simulations: int = ..., max_iterations: int = ..., tolerance: float = ..., method: Literal['L-BFGS-B', 'Powell'] = ...) -> AnalysisResult: ...
    def fit_population(self, subjects: list[AnalysisSubject] | list[dict[str, Any]], parameters: dict[str, ParameterSpec] | dict[str, Any], omega: Sequence[Sequence[float]], error: ResidualError | FixedResidualError | dict[str, Any], *, covariates: Sequence[CovariateSpec] = ..., covariance: Literal['full', 'diagonal'] = ..., variance_bounds: Sequence[float] | Sequence[Sequence[float]] = ..., seed: int = ..., max_iterations: int = ..., burn_in: int = ..., sweeps: int = ..., tolerance: float = ..., max_simulations: int = ..., control: AnalysisControl | None = ...) -> AnalysisResult: ...
    def visual_predictive_check(self, subjects: list[AnalysisSubject] | list[dict[str, Any]], parameters: dict[str, Quantity] | dict[str, Any], omega: Sequence[Sequence[float]], error: FixedResidualError | dict[str, Any], *, random_effects: Sequence[str] | None = ..., covariates: Sequence[CovariateEstimate] = ..., replicates: int = ..., bins: Sequence[float] | None = ..., percentiles: Sequence[float] = ..., confidence: float = ..., prediction_corrected: bool = ..., stratify: Sequence[str] = ..., seed: int = ..., max_simulations: int = ..., control: AnalysisControl | None = ..., workers: int = ...) -> AnalysisResult: ...
    def profile_likelihood(self, run: RunRequest | dict[str, Any], observations: list[AnalysisObservation] | list[dict[str, Any]], parameters: dict[str, ParameterSpec] | dict[str, Any], error: ResidualError | FixedResidualError | dict[str, Any], parameter: str, grid: Sequence[float], *, confidence: float = ..., max_simulations: int = ..., max_iterations: int = ...) -> AnalysisResult: ...
    def bootstrap_population(self, subjects: list[AnalysisSubject] | list[dict[str, Any]], parameters: dict[str, ParameterSpec] | dict[str, Any], omega: Sequence[Sequence[float]], error: ResidualError | FixedResidualError | dict[str, Any], *, replicates: int = ..., confidence: float = ..., seed: int = ..., minimum_success_fraction: float = ..., max_simulations: int = ..., control: AnalysisControl | None = ..., covariates: Sequence[CovariateSpec] = ..., covariance: Literal['full', 'diagonal'] = ..., variance_bounds: Sequence[float] | Sequence[Sequence[float]] = ..., max_iterations: int = ..., burn_in: int = ..., sweeps: int = ..., tolerance: float = ...) -> AnalysisResult: ...
    def compare_regimens(self, regimens: dict[str, RunRequest] | dict[str, Any], parameters: dict[str, Quantity] | dict[str, Any], omega: Sequence[Sequence[float]], output: str, *, random_effects: Sequence[str] | None = ..., subjects: int = ..., seed: int = ..., threshold: float | None = ..., percentiles: Sequence[float] = ..., parameter_draws: Sequence[dict[str, Quantity]] | None = ..., max_simulations: int = ...) -> AnalysisResult: ...
    def event_sensitivities(self, run: RunRequest | dict[str, Any], parameters: dict[str, Quantity] | dict[str, Any], *, relative_step: float = ..., relative_tolerance: float = ..., absolute_tolerance: float = ..., max_simulations: int = ...) -> AnalysisResult: ...

def format_model(source: str | dict[str, Any]) -> str: ...

def fitting_identity(source: str | dict[str, Any], request: str | dict[str, Any], operation: Literal['fit_scalar', 'fit_individual'], *, result: str | dict[str, Any] | None = ...) -> dict[str, Any]: ...

